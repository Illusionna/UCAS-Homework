\relax 
\@writefile{toc}{\contentsline {section}{\numberline {1}$\setbox \z@ \hbox {\mathsurround \z@ $\textstyle f+g$}\mathaccent "0362{f+g} = \hat  {f} + \hat  {g}$ 且对任意 $\alpha \in \mathbb  {C}, \setbox \z@ \hbox {\mathsurround \z@ $\textstyle (\alpha f)$}\mathaccent "0362{(\alpha f)} = \alpha \hat  {f}$}{1}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}$\bar  {f}$ 是由函数 $f$ 取复共轭得到，则 $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle (\bar  {f})$}\mathaccent "0362{(\bar  {f})}(y) = \overline  {\hat  {f}(-y)}$}{1}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}若 $h(x) := f(x+z)$ 则 $\hat  {h}(y) = \hat  {f}(y) \cdot \mathrm  {e}^{2\pi izy}$}{2}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}若 $h(x) := \mathrm  {e}^{2\pi izx}f(x)$ 则 $\hat  {h}(y) = \hat  {f}(y - z)$}{2}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}$|\hat  {f}(y)| \leqslant \displaystyle \DOTSI \intop \ilimits@ _{-\infty }^{\infty } |f(x)|\mathrm  {d}x$}{2}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}$\forall \lambda > 0$，若 $h(x) := \lambda f(\lambda x)$ 则 $\hat  {h}(y) = \hat  {f}\left (\dfrac  {y}{\lambda }\right )$}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}$\setbox \z@ \hbox {\mathsurround \z@ $\textstyle f * g$}\mathaccent "0362{f * g} = \hat  {f} \cdot \hat  {g}$ 且 $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle f \cdot g$}\mathaccent "0362{f \cdot g} = \hat  {f} * \hat  {g}$}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {8}若 $h(x) = f'(x) \in L^1(\mathbb  {R})$ 则 $\hat  {h}(y) = 2\pi iy\hat  {f}(y)$}{5}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {9}设 $\bm  {B}$ 是非奇异的方阵，试计算 $\hat  {f}_{\bm  {B}}(\vec  {\bm  {y}})$ 其中 $f_{\bm  {B}}(\vec  {\bm  {x}}) = f(\bm  {B}\vec  {\bm  {x}})$}{5}{}\protected@file@percent }
\gdef \@abspage@last{7}
